@startuml
skinparam classAttributeIconSize 0

' --- USER MANAGEMENT ---
abstract class Person {
  # id: String
  # name: String
  # email: String
  # password: String
  + Person(id: String, name: String, email: String, password: String)
  + virtual ~Person() = default
  + getId(): String {const}
  + getName(): String {const}
  + getEmail(): String {const}
  + checkPassword(pwd: String): boolean {const}
  + setPassword(pwd: String): void
  + setName(name: String): void
  + setEmail(email: String): void
  + {abstract} displayMenu(): void
  + {abstract} getRole(): String {const}
}

class Student {
  - completedCourses: List<String>
  - enrolledCourses: List<Course*>
  + enrolCourse(course: Course*): void
  + dropCourse(course: Course*): void
  + viewTimetable(): Timetable {const}
  + getEnrolledCourses(): List<Course*> {const}
  + hasCompleted(courseCode: String): boolean {const}
  + displayMenu(): void
  + getRole(): String {const}
  + friend operator<<(os: ostream&, s: const Student&): ostream&
}

class Lecturer {
  - assignedCourses: List<Course*>
  + displayMenu(): void
  + getRole(): String {const}
  + viewEnrolmentList(course: Course*): void
  + openAttendanceSession(course: Course*, slot: const TimeSlot&, duration: int): AttendanceSession*
}

class Admin {
  + displayMenu(): void
  + getRole(): String {const}
  + manageUsers(students: List<Student*>&, lecturers: List<Lecturer*>&, admins: List<Admin*>&): void
  + manageCourses(allCourses: List<Course*>&, lecturers: List<Lecturer*>&): void
  + generateReport(allCourses: List<Course*>&): void
}

Person <|-- Student : Inheritance
Person <|-- Lecturer : Inheritance
Person <|-- Admin : Inheritance

' --- COURSE MANAGEMENT ---
abstract class Course {
  # code: String
  # title: String
  # capacity: int
  # lecturer: Lecturer*
  # prerequisites: List<Course*>
  # enrolledStudents: List<Student*>
  # timetable: Timetable
  + Course(code: String, title: String, cap: int, lec: Lecturer*)
  + virtual ~Course()
  + Course(const Course& other)
  + Course(Course&& other) noexcept
  + operator=(const Course& other): Course&
  + operator=(Course&& other) noexcept: Course&
  + getCode(): String {const}
  + getTitle(): String {const}
  + getCapacity(): int {const}
  + setTitle(newTitle: String): void
  + setCapacity(newCapacity: int): void
  + getLecturer(): Lecturer* {const}
  + getTimetable(): Timetable&
  + isFull(): boolean {const}
  + addPrerequisite(c: Course*): void
  + getPrerequisites(): List<Course*>& {const}
  + addEnrolledStudent(s: Student*): void
  + removeEnrolledStudent(s: Student*): void
  + getEnrolledStudents(): List<Student*>& {const}
  + {abstract} getCredits(): int {const}
  + {abstract} calculateGrade(rawScore: double): double {const}
  + friend operator<<(os: ostream&, c: const Course&): ostream&
}

class LectureCourse {
  + getCredits(): int {const}
  + calculateGrade(rawScore: double): double {const}
}

class LabCourse {
  + getCredits(): int {const}
  + calculateGrade(rawScore: double): double {const}
}

class ProjectCourse {
  + getCredits(): int {const}
  + calculateGrade(rawScore: double): double {const}
}

Course <|-- LectureCourse
Course <|-- LabCourse
Course <|-- ProjectCourse

Student "0..*" o-- "0..*" Course : Enrolment
Lecturer "1" o-- "0..*" Course : Teaches >

' --- TIMETABLE & CLASH DETECTION ---
class TimeSlot {
  - day: String
  - startTime: String
  - endTime: String
  - location: String
  + TimeSlot(day: String, start: String, end: String, loc: String)
  + getDay(): String {const}
  + getStartTime(): String {const}
  + getEndTime(): String {const}
  + getLocation(): String {const}
  + operator==(const TimeSlot& other): boolean {const}
  + friend operator<<(os: ostream&, t: const TimeSlot&): ostream&
}

class Timetable {
  - slots: List<TimeSlot>
  + addSlot(slot: TimeSlot): void
  + removeSlot(index: size_t): void
  + updateSlot(index: size_t, newSlot: TimeSlot): void
  + hasClash(newSlot: const TimeSlot&): boolean {const}
  + getSlots(): List<TimeSlot>&
  + friend operator<<(os: ostream&, t: const Timetable&): ostream&
}

Timetable "1" *-- "0..*" TimeSlot : Composition
Course "1" *-- "1" Timetable : Composition

' --- PERSISTENCE & DTO RECORDS ---
class UserRecord {
  + role: String
  + id: String
  + name: String
  + email: String
  + password: String
}

class CourseRecord {
  + type: String
  + code: String
  + title: String
  + capacity: int
  + lecturerId: String
  + prerequisites: String
}

class EnrolmentRecord {
  + studentId: String
  + courseCode: String
}

class LogEntry {
  + timestamp: String
  + level: String
  + message: String
  + serialize(): String {const}
  + {static} deserialize(line: String): LogEntry
}

class "Repository<T>" as Repository {
  + loadFromFile(filename: String): List<T>
  + saveToFile(filename: String, data: List<T>): void
}

Repository ..> UserRecord : serializes >
Repository ..> CourseRecord : serializes >
Repository ..> EnrolmentRecord : serializes >
Repository ..> LogEntry : serializes >

' --- EXCEPTIONS ---
class "std::exception" as StdException

class DomainException {
  # message: String
  + DomainException(msg: String)
  + what(): const char* {override}
}

StdException <|-- DomainException

class DuplicateEnrolmentException
class PrerequisiteNotMetException
class CourseFullException
class TimetableClashException
class SessionClosedException
class UnauthorizedAccessException
class NotEnrolledException
class DuplicateAttendanceException
class DataCorruptionException

DomainException <|-- DuplicateEnrolmentException
DomainException <|-- PrerequisiteNotMetException
DomainException <|-- CourseFullException
DomainException <|-- TimetableClashException
DomainException <|-- SessionClosedException
DomainException <|-- UnauthorizedAccessException
DomainException <|-- NotEnrolledException
DomainException <|-- DuplicateAttendanceException
DomainException <|-- DataCorruptionException

' --- ATTENDANCE SYSTEM ---
class AttendanceRecord {
  - studentId: String
  - courseCode: String
  - sessionId: String
  - timestamp: String
  - status: String
  - captureMethod: String
  - isCorrection: boolean
  - lecturerId: String
  - reason: String
  + AttendanceRecord(...)
  + getStudentId(): String {const}
  + getStatus(): String {const}
}

class AttendanceSession {
  - sessionId: String
  - courseCode: String
  - durationMinutes: int
  - openTime: time_t
  - isOpen: boolean
  - records: List<AttendanceRecord*>
  + AttendanceSession(id: String, course: String, dur: int)
  + markPresent(s: Student*, c: Course*, method: String): void
  + addCorrection(s: Student*, status: String, l: Lecturer*, reason: String): void
  + close(): void
  + isExpired(): boolean {const}
}

interface AttendanceCapture {
  + {abstract} captureAttendance(s: Student*, c: Course*): boolean
}

class RotatingCodeCapture {
  - currentPasscode: String
  - expiryTime: time_t
  + generateNewCode(): String
  + verifyCode(input: String): boolean
  + captureAttendance(s: Student*, c: Course*): boolean
}

class FileReplayCapture {
  - replayFilePath: String
  + processReplay(session: AttendanceSession*): void
  + captureAttendance(s: Student*, c: Course*): boolean
}

AttendanceCapture <|.. RotatingCodeCapture : Realizes
AttendanceCapture <|.. FileReplayCapture : Realizes
AttendanceSession ..> AttendanceCapture : uses >
AttendanceSession "1" *-- "0..*" AttendanceRecord : Composition
@enduml