@startuml new new
skinparam classAttributeIconSize 0

' --- USER MANAGEMENT ---
abstract class Person {
  - id: String
  - name: String
  - email: String
  - password: String
  + {abstract} displayMenu(): void
  + getRole(): String
}
class Student {
  - enrolledCourses: List<Course*>
  + enrol(course: Course&): void 
  + drop(course: Course&): void 
  + viewTimetable(): Timetable
  + displayMenu(): void
  + friend operator<<(os, s: Student&): ostream&
}
class Lecturer {
  + displayMenu(): void
  + viewEnrolmentList(courseCode: String): void
  + openAttendanceSession(courseCode: String, slot: TimeSlot, duration: int): AttendanceSession
}
class Admin {
  + displayMenu(): void
  + createUsers(): void
  + removeUsers(): void
  + manageUsers(): void
  + createCourses(): void
  + removeCourses(): void
  + manageCourses(): void
  + generateReport(): void
}
Person <|-- Student : Inheritance
Person <|-- Lecturer : Inheritance
Person <|-- Admin : Inheritance

' --- COURSE MANAGEMENT ---
abstract class Course {
  - code: String
  - title: String
  - capacity: int
  - prerequisites: List<Course*>
  - {static} totalCourseCount: int
  + {abstract} getCredits(): int
  + {abstract} calculateGrade(): void
  + checkPrerequisites(student: Student*): boolean
  + {static} getTotalCourseCount(): int
  + friend operator<<(os, c: Course&): ostream&
  + getAttendancePercentage(s: Student*): double
  + getCourseAttendancePercentage(): double
}

class LectureCourse {
  + getCredits(): int
  + calculateGrade(): void
}
class LabCourse {
  + getCredits(): int
  + calculateGrade(): void
}
class ProjectCourse {
  + getCredits(): int
  + calculateGrade(): void
}
Course <|-- LectureCourse
Course <|-- LabCourse
Course <|-- ProjectCourse

Course "0..*" o-- "0..*" Student : Aggregation (Enrolment)
Lecturer "1" o-- "0..*" Course : teaches >

' --- TIMETABLE & CLASH DETECTION ---
class TimeSlot {
  - day: String
  - startTime: String
  - endTime: String
  - location: String
  + operator==(other: TimeSlot): boolean
  + friend operator<<(os, t: TimeSlot&): ostream&
}
class Timetable {
  - slots: List<TimeSlot>
  + addSlot(slot: TimeSlot): void
  + hasClash(other: Timetable): boolean
  + friend operator<<(os, t: Timetable&): ostream&
}
Timetable "1" *-- "1..*" TimeSlot : Composition
Course "1" *-- "1" Timetable : Composition

' --- PERSISTENCE ---
class "Repository<T>" as Repository {
  + loadFromFile(filename: String): List<T>
  + saveToFile(filename: String, data: List<T>): void
}
Student ..> Repository : persisted via >
Course ..> Repository : persisted via >
AttendanceSession ..> Repository : persisted via >
' --- EXCEPTIONS ---
abstract class DomainException {
  # message: String
  + explicit DomainException(msg: String)
  + what(): const char* {override}
}
abstract class EnrolmentException
abstract class AttendanceException
class TimetableClashException

 class DataCorruptionException {
  + DataCorruptionException(filename: String, reason: String)
}

class UnauthorizedAccessException {
  + UnauthorizedAccessException(msg: String)
}

class PrerequisiteNotMetException {
  + PrerequisiteNotMetException(courseCode: String)
}
class CourseFullException {
  + CourseFullException(courseCode: String)
}
class SessionClosedException {
  + SessionClosedException(sessionId: String)
}
class NotEnrolledException {
  + NotEnrolledException(studentId: String, courseCode: String)
}
class DuplicateAttendanceException {
  + DuplicateAttendanceException(studentId: String, sessionId: String)
}

std.exception <|-- DomainException
DomainException <|-- EnrolmentException
DomainException <|-- AttendanceException
DomainException <|-- TimetableClashException
DomainException <|-- DataCorruptionException
DomainException <|-- UnauthorizedAccessException
EnrolmentException <|-- PrerequisiteNotMetException
EnrolmentException <|-- CourseFullException
AttendanceException <|-- SessionClosedException
AttendanceException <|-- NotEnrolledException
AttendanceException <|-- DuplicateAttendanceException

' --- ATTENDANCE SYSTEM ---
class AttendanceRecord {
  - student: Student*
  - session: AttendanceSession*
  - timestamp: String
  - status: String
  - capturedVia: String
  - isCorrection: boolean
  - actingLecturer: Lecturer*
  - reason: String
  + AttendanceRecord(student: Student*, session: AttendanceSession*, status: String, capturedVia: String)
  + getStudent(): Student*
  + getStatus(): String {const}
}
class AttendanceSession {
  - sessionId: String
  - courseCode: String
  - isOpen: boolean
  - duration: int
  - openTime: time_t
  - capture: AttendanceCapture*
  + close(): void
  + isExpired(): boolean
  + markPresent(s: Student*): void
  + setCaptureMechanism(c: AttendanceCapture*): void
}
interface AttendanceCapture {
  + {abstract} beginSession(): void
  + {abstract} captureNext(): String
  + {abstract} endSession(): void
}
class FileReplayCapture {
  - inputFile: String
  + beginSession(): void
  + captureNext(): String
  + endSession(): void
}
class RotatingCodeCapture {
  - currentCode: String
  + beginSession(): void
  + captureNext(): String
  + endSession(): void
}
AttendanceCapture <|.. FileReplayCapture : Realizes
AttendanceCapture <|.. RotatingCodeCapture : Realizes
AttendanceSession ..> AttendanceCapture : uses >

AttendanceSession "1" *-- "0..*" AttendanceRecord : Composition
AttendanceRecord "0..*" --> "1" Student : Refers to
AttendanceRecord "0..*" --> "1" Lecturer : records correction
Course "1" *-- "0..*" AttendanceSession : Composition

@enduml